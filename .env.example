# CAUFASYSTEM — environment template (SAFE TO COMMIT)
# Copy to .env and fill in real values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

APP_NAME=CAUFASYSTEM
APP_ENV=development
DEBUG=True

# Production (.env on the server, NEVER commit):
#   APP_ENV=production
#   DEBUG=False
#   SECRET_KEY=<fresh 64-hex from: python -c "import secrets; print(secrets.token_hex(32))">
#   ALLOWED_HOSTS=isucaufa-fms.online,www.isucaufa-fms.online
#   BASE_URL=https://isucaufa-fms.online

# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=isucaufafms_capstone_project_db
DB_USER=root
DB_PASSWORD=changeme
DATABASE_URL=mysql+pymysql://root:changeme@localhost:3306/isucaufafms_capstone_project_db

# --- Auth / sessions ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_EXPIRE_HOURS=8

# --- Transport security (TLS/HTTPS) ---
# Local dev behind nginx+mkcert: True. Plain runserver dev: False.
# Production (APP_ENV=production): HTTPS is forced regardless of this flag.
HTTPS_ENABLED=False
# HSTS max-age in seconds (31536000 = 1 year). 0 disables HSTS header.
SECURE_HSTS_SECONDS=31536000

# --- MySQL TLS (deploy/mysql_tls_server.sql + mysql_tls.cnf) ---
# Point at the CA that signed the DB server cert; add CERT/KEY for X509
# client auth (REQUIRE X509). Leave all empty = legacy plaintext (local dev).
# DB_SSL_ENFORCE=True fails startup instead of connecting without TLS.
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY_IDENTITY=True
DB_SSL_ENFORCE=False

# --- SMTP TLS ---
# Fail-closed: the mail backend refuses plaintext SMTP unless False
# (local test relay only — OTP codes + app passwords cross this wire).
EMAIL_REQUIRE_TLS=True

# --- URL encryption & obfuscation ---
# Master kill-switch (False = plain URLs everywhere, verifier off).
URL_OBFUSCATION_ENABLED=True
# True = query-bearing covered URLs without a token also 404 (flip only
# after all clients sign; default False keeps old bookmarks working while
# any present-but-tampered token still 404s).
URL_OBFUSCATION_REQUIRE_SIGNATURE=False

# --- Hosting mode: local/VPS vs shared cPanel (same codebase, both ways) ---
# Local dev / VPS: leave both False (needs REDIS_URL in production).
# Shared cPanel Passenger (single worker, no Redis, no ASGI, no root):
#   CPANEL_MODE=True
# This implies SINGLE_WORKER_MODE=True (locmem cache allowed in prod) and
# DISABLE_BACKGROUND_SCHEDULER=True (use cPanel Cron, see deploy/cpanel-cron.txt).
# WebSockets degrade to polling automatically (static/js/shared/realtime.js).
CPANEL_MODE=False
# Single-worker prod without Redis (cPanel shared). NEVER True on multi-worker.
SINGLE_WORKER_MODE=False
# In-process APScheduler off (cPanel Cron replaces it). Local dev keeps False.
DISABLE_BACKGROUND_SCHEDULER=False

# --- Static files ---
# `collectstatic` target. Same default both ways; cPanel maps /static/ here
# or lets Passenger serve it. Override only if the host mandates another path.
STATIC_ROOT=./staticfiles

# --- Cache / channels (VPS/multi-worker prod only) ---
# Shared cPanel: leave empty + CPANEL_MODE=True. VPS prod: set it, e.g.
# REDIS_URL=redis://:STRONGPASS@127.0.0.1:6379/1 (requirepass + TLS).
REDIS_URL=
